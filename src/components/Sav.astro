---
// Crtež „prošiven koncem” na obojenim karticama bez fotografije.
// Vidljivi šav je isprekidana linija; preko nje ide „pokrivač” u boji kartice koji se pri
// animaciji povlači i otkriva šav (radi u svim pregledačima, bez maski).
// Debljinu šava (2 px na ekranu) podešava skripta sav.ts prema stvarnoj veličini crteža.
const { vrsta, boja, pozadina, klasa = '' } = Astro.props as { vrsta: string; boja: string; pozadina: string; klasa?: string };

const krug = (cx: number, cy: number, r: number) => `M${cx} ${cy - r} A${r} ${r} 0 1 1 ${cx} ${cy + r} A${r} ${r} 0 1 1 ${cx} ${cy - r}`;
const igla = 'M1 6 L35 4.8 L43 6 L35 7.2 Z';

const oblici: Record<string, { linije: string[]; ispuna?: Record<number, boolean> }> = {
  meta: { linije: [krug(50, 52, 30), krug(50, 52, 18), 'M94 10 Q80 22 65 38'] },
  grafikon: { linije: ['M14 80 L32 62 L48 70 L66 44 L84 24'] },
  oblacici: {
    linije: [
      'M22 24 H52 A10 10 0 0 1 62 34 V48 A10 10 0 0 1 52 58 H30 L20 68 L22 58 A10 10 0 0 1 12 48 V34 A10 10 0 0 1 22 24 Z',
      'M48 46 H78 A10 10 0 0 1 88 56 V66 A10 10 0 0 1 78 76 H76 L80 86 L66 76 H48 A10 10 0 0 1 38 66 V56 A10 10 0 0 1 48 46 Z',
    ],
    ispuna: { 1: true },
  },
};
const o = oblici[vrsta];
---
{o && (
  <svg class={`sav ${klasa}`} viewBox="0 0 100 100" aria-hidden="true" focusable="false" data-sav>
    {o.linije.map((d, i) => (
      <>
        {o.ispuna?.[i] && <path d={d} fill={pozadina}></path>}
        <path class="sav-st" d={d} stroke={boja} fill="none" stroke-width="1.4" stroke-dasharray="3.4 2.7"></path>
        <path class="sav-pokr" d={d} stroke={pozadina} fill="none" pathLength="1"></path>
      </>
    ))}
    {vrsta === 'grafikon' && <path class="sav-osa" d="M10 86 H90 M10 86 V14" stroke={boja} fill="none" stroke-width=".7"></path>}
    {vrsta === 'meta' && (
      <>
        <circle class="sav-kas" cx="50" cy="52" r="4.5" fill={boja}></circle>
        <g class="sav-kas" transform="translate(52 50) rotate(138) scale(.5) translate(-43 -6)"><path d={igla} fill="#FBF6EF"></path><ellipse cx="7" cy="6" rx="3.2" ry=".8" fill={pozadina}></ellipse></g>
      </>
    )}
    {vrsta === 'grafikon' && (
      <>
        <g class="sav-kas" fill={boja}><circle cx="32" cy="62" r="2.6"></circle><circle cx="48" cy="70" r="2.6"></circle><circle cx="66" cy="44" r="2.6"></circle></g>
        <g class="sav-kas" transform="translate(84 24) rotate(-50) scale(.5) translate(-7 -6)"><path d={igla} fill="#FBF6EF"></path><ellipse cx="7" cy="6" rx="3.2" ry=".8" fill={pozadina}></ellipse></g>
      </>
    )}
    {vrsta === 'oblacici' && <g class="sav-kas" fill={boja}><circle cx="28" cy="41" r="2.6"></circle><circle cx="37" cy="41" r="2.6"></circle><circle cx="46" cy="41" r="2.6"></circle></g>}
  </svg>
)}
