---
import Base from '../layouts/Base.astro';
import Zaglavlje from '../components/Zaglavlje.astro';
---
<Base naslov="Hvala na prijavi · Story & Scroll Studio" opis="Prijava za konsultacije je poslata." bezIndeksa={true}>
  <Zaglavlje />
  <main class="wrap" id="sadrzaj" style="padding:120px 0;text-align:center">
    <h1 class="h1">Hvala <em>na prijavi!</em></h1>
    <p class="caption" style="margin:24px auto 0">Javićemo Vam se uskoro na navedeni email ili telefon.</p>
    <p style="margin-top:30px"><a class="btn btn-p" href="/">Nazad na početnu</a></p>
  </main>
</Base>
