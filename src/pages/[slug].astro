---
import Base from '../layouts/Base.astro';
import Zaglavlje from '../components/Zaglavlje.astro';
import Objava from '../components/Objava.astro';
import Sekcija from '../components/Sekcija.astro';
import Ikona from '../components/Ikona.astro';
import site from '../data/site.json';
import objave from '../data/objave.json';
import { slika } from '../data/slike';

export function getStaticPaths() {
  const fajlovi = import.meta.glob('../data/stranice/*.json', { eager: true });
  return Object.values(fajlovi).map((m: any) => ({ params: { slug: m.default.slug }, props: { s: m.default } }));
}
const { s } = Astro.props;
const o = objave.find((x) => x.kljuc === s.objava)!;
const hs = o.slika ? slika(o.slika) : null;
---
<Base naslov={s.seo.naslov} opis={s.seo.opis} jezicak={s.jezicak}>
  <Zaglavlje />
  <main class="wrap" id="sadrzaj">
    <nav class="crumb" aria-label="Putanja">
      <a href="/">← Nazad na feed</a>
      {s.putanja.map((p: any) => typeof p === 'string'
        ? <><span aria-hidden="true">/</span><span aria-current="page">{p}</span></>
        : <><span aria-hidden="true">/</span><a href={p.link}>{p.naziv}</a></>)}
    </nav>

    <section class="head">
      <div class="hpost" style={`background:${o.boja};${o.tamnoSlovo ? 'color:#6E1423;' : ''}`}>
        {hs && <><img src={hs.src} srcset={hs.srcset} sizes="(max-width: 900px) 360px, 380px" alt={o.alt} width="380" height="475" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"><span style="position:absolute;inset:0;background:linear-gradient(to top, rgba(24,16,13,.75), rgba(24,16,13,.05) 60%)"></span></>}
        <div class="pt" style="position:relative"><span>{site.naziv}</span></div>
        <div style="position:relative"><p class="ttl">{o.naslov}</p><p class="lbl" style={o.tamnoSlovo ? 'color:#8C6A2A' : undefined}>{o.oznaka}</p></div>
      </div>
      <div>
        <p class="eyebrow">{s.nadnaslov}</p>
        <h1 class="h1">{s.naslov} <em>{s.naslovIstaknuto}</em></h1>
        <div class="stitch" aria-hidden="true"><svg class="needle" width="44" height="12" viewBox="0 0 44 12"><path d="M1 6 L35 4.8 L43 6 L35 7.2 Z" fill="#A9A39B"></path><ellipse cx="7" cy="6" rx="3.2" ry=".8" fill="#FBF6EF"></ellipse></svg></div>
        <p class="caption"><a href={site.instagram} style="color:#2B211D;font-weight:600;margin-right:6px;text-decoration:none">{site.handle}</a>{s.opis}</p>
        <ul class="trust" style="list-style:none;padding:0;margin-bottom:0">
          {s.znaci.map((z: any) => <li class="tb"><Ikona ime={z.ikona} velicina={36} debljina={1.8} /> {z.tekst}</li>)}
        </ul>
        {s.link && <a class="golink" href={s.link.link}>{s.link.tekst}</a>}
      </div>
    </section>

    <nav class="hls" aria-label="Na ovoj stranici">
      {s.istaknuto.map((h: any) => <a class="hl" href={h.link}><span style={`background:${h.boja}`}><Ikona ime={h.ikona} /></span>{h.naziv}</a>)}
    </nav>

    {s.sekcije.map((sek: any) => <Sekcija s={sek} />)}

    <section class="sec" aria-label="Još objava">
      <p class="eyebrow">Još objava</p>
      <div class="more">{s.jos.map((k: string) => <Objava kljuc={k} />)}</div>
    </section>
  </main>

  <section class="ctab">
    <h2>{s.poziv.naslov} <em>{s.poziv.naslovIstaknuto}</em></h2>
    <p>{s.poziv.tekst}</p>
    <div style="display:flex;justify-content:center;margin-top:30px"><a class="btn btn-c" href={s.poziv.link}>{s.poziv.dugme}</a></div>
  </section>
</Base>

<script>
  import { pokreniKaruseli } from '../scripts/karusel';
  import { pokreniObrazac } from '../scripts/obrazac';
  pokreniKaruseli();
  pokreniObrazac();
</script>
